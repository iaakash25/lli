// Leather Lux India — PostgreSQL schema (Phase 1 draft).
//
// Conventions
//  - UUID primary keys generated by the database (gen_random_uuid(), built in to PostgreSQL 13+).
//  - Money is integer paise (Int). Never floats. Currency is INR.
//  - Timestamps are timestamptz in UTC.
//  - Tables/columns are snake_case in the database, camelCase in Prisma.
//  - CHECK constraints, partial unique indexes, generated columns, triggers and the pg_trgm
//    extension are added in prisma/migrations/0002_constraints (Prisma cannot express them).
//  - All objects live in the `public` schema of the LLI database. Nothing outside LLI is touched.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  GUEST_ORDER_ACCESS

  @@map("token_purpose")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum Gender {
  WOMEN
  MEN
  UNISEX

  @@map("gender")
}

enum CollectionKind {
  MANUAL
  RULE

  @@map("collection_kind")
}

enum MediaStatus {
  QUARANTINED
  READY
  REJECTED

  @@map("media_status")
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum MovementReason {
  PURCHASE_RECEIPT
  SALE
  RETURN_RESTOCK
  ADJUSTMENT
  DAMAGE
  CORRECTION

  @@map("movement_reason")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLATION_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("order_status")
}

enum PaymentMethod {
  ONLINE
  COD

  @@map("payment_method")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  REVIEW_REQUIRED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED

  @@map("refund_status")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED

  @@map("shipment_status")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUND_PENDING
  CLOSED

  @@map("return_status")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN

  @@map("review_status")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum AiRole {
  USER
  ASSISTANT
  TOOL

  @@map("ai_role")
}

enum JobStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("job_status")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String
  emailNormalized    String     @map("email_normalized") // lower(trim(email)); uniqueness is on this
  phone              String?
  passwordHash       String?    @map("password_hash") // Argon2id; null for accounts without a password
  fullName           String?    @map("full_name")
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  isStaff            Boolean    @default(false) @map("is_staff")
  tokenVersion       Int        @default(0) @map("token_version") // bump to revoke every session
  permissionsVersion Int        @default(0) @map("permissions_version") // bump to invalidate cached RBAC
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  userRoles         UserRole[]
  sessions          Session[]
  oneTimeTokens     OneTimeToken[]
  mfaCredentials    MfaCredential[]
  addresses         Address[]
  consents          Consent[]
  carts             Cart[]
  wishlist          Wishlist?
  orders            Order[]
  reviews           Review[]
  returnRequests    ReturnRequest[]
  couponRedemptions CouponRedemption[]
  aiConversations   AiConversation[]
  auditLogs         AdminAuditLog[]    @relation("AuditActor")
  securityEvents    SecurityEvent[]

  @@unique([emailNormalized], map: "users_email_normalized_key")
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // seeded roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique // e.g. products.update, refunds.approve
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Refresh-token sessions. Only the SHA-256 hash of the token is stored.
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid // all rotations of one login share a family
  tokenHash     String    @unique @map("token_hash")
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3) // absolute lifetime
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") // e.g. logout, reuse_detected, password_change
  ipHash        String?   @map("ip_hash") // hashed; raw IPs are not stored here
  userAgent     String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// Email verification, password reset and guest order-access tokens (hash only).
model OneTimeToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash")
  subjectRef String?      @map("subject_ref") // e.g. order id for GUEST_ORDER_ACCESS
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("one_time_tokens")
}

model MfaCredential {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  type               String // "totp" | "webauthn"
  secretEncrypted    Bytes     @map("secret_encrypted") // application-level encryption; key not in the DB
  recoveryCodeHashes String[]  @map("recovery_code_hashes")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_credentials")
}

model Address {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  label      String?
  fullName   String    @map("full_name")
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  stateCode  String    @map("state_code") // GST state code, drives CGST/SGST vs IGST
  postalCode String    @map("postal_code")
  country    String    @default("IN")
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// DPDP: purpose-specific, versioned, withdrawable consent with proof.
model Consent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  purpose     String // e.g. terms, privacy, marketing_email, marketing_whatsapp
  version     String // version of the notice shown
  granted     Boolean
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  ipHash      String?   @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
}

// Append-only record of login/lockout/MFA/reuse events.
model SecurityEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String // login_success, login_failed, lockout, refresh_reuse, password_reset, ...
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String        @unique
  name           String
  tagline        String?
  description    String?
  productType    String        @map("product_type") // wallet, tote, crossbody, ...
  gender         Gender        @default(UNISEX)
  material       String?
  dimensions     String?
  careNotes      String?       @map("care_notes")
  hsnCode        String?       @map("hsn_code") // GST classification
  taxRateId      String?       @map("tax_rate_id") @db.Uuid
  status         ProductStatus @default(DRAFT)
  isNew          Boolean       @default(false) @map("is_new")
  isBestseller   Boolean       @default(false) @map("is_bestseller")
  isGift         Boolean       @default(false) @map("is_gift")
  rank           Int           @default(0)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  taxRate       TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  images        ProductImage[]
  categories    ProductCategory[]
  collections   CollectionProduct[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([status, rank])
  @@index([productType])
  @@index([gender])
  @@map("products")
}

// One sellable SKU: a product in a given colour/size.
model ProductVariant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  sku            String    @unique
  colourName     String?   @map("colour_name")
  colourSwatch   String?   @map("colour_swatch") // hex, e.g. #642F3B
  size           String?
  pricePaise     Int       @map("price_paise")
  compareAtPaise Int?      @map("compare_at_paise")
  costPaise      Int?      @map("cost_paise") // staff-only; never returned to customers
  weightGrams    Int?      @map("weight_grams")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  reservations InventoryReservation[]
  movements    InventoryMovement[]
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model MediaAsset {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey   String      @unique @map("storage_key") // S3 key in the public prefix once READY
  contentType  String      @map("content_type")
  sizeBytes    Int         @map("size_bytes")
  width        Int?
  height       Int?
  sha256       String?
  altText      String?     @map("alt_text")
  status       MediaStatus @default(QUARANTINED)
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  productImages ProductImage[]
  banners       Banner[]
  collections   Collection[]

  @@map("media_assets")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  position  Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  media   MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Collection {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String         @unique
  title       String
  eyebrow     String?
  intro       String?
  kind        CollectionKind @default(MANUAL)
  rule        Json? // whitelisted filter definition for RULE collections; validated by Zod
  heroMediaId String?        @map("hero_media_id") @db.Uuid
  sortOrder   Int            @default(0) @map("sort_order")
  status      PublishStatus  @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  heroMedia MediaAsset?         @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  products  CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

// ───────────────────────────── Inventory ─────────────────────────────

// One row per variant. CHECK (on_hand >= 0 AND reserved >= 0 AND reserved <= on_hand) is in 0002.
model Inventory {
  variantId         String   @id @map("variant_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryReservation {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  orderId   String?           @map("order_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt DateTime?         @map("settled_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([variantId])
  @@map("inventory_reservations")
}

// Append-only ledger of every stock change.
model InventoryMovement {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  delta         Int // signed change to on_hand
  reason        MovementReason
  referenceType String?        @map("reference_type") // order, return, adjustment
  referenceId   String?        @map("reference_id")
  actorId       String?        @map("actor_id") @db.Uuid
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ───────────────────────── Cart & wishlist ─────────────────────────

model Cart {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash")
  status         CartStatus @default(ACTIVE)
  couponCode     String?    @map("coupon_code")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ───────────────────────── Tax & promotions ─────────────────────────

// GST rates are configuration, not constants in code (CA sign-off required before launch).
model TaxRate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique // e.g. "GST 18%"
  rateBasisPoints Int      @map("rate_basis_points") // 1800 = 18.00%
  effectiveFrom   DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  isActive        Boolean  @default(true) @map("is_active")

  products Product[]

  @@map("tax_rates")
}

model Coupon {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String // stored upper-case; unique on code
  description      String?
  discountType     DiscountType @map("discount_type")
  discountValue    Int          @map("discount_value") // percent in basis points, or paise for FIXED
  maxDiscountPaise Int?         @map("max_discount_paise")
  minSubtotalPaise Int          @default(0) @map("min_subtotal_paise")
  usageLimit       Int?         @map("usage_limit")
  perUserLimit     Int?         @map("per_user_limit")
  usedCount        Int          @default(0) @map("used_count")
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(3)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  redemptions CouponRedemption[]
  orders      Order[]

  @@unique([code])
  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─────────────────────── Orders, payments, refunds ───────────────────────

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String        @unique @map("order_number") // human-facing, non-sequential-guessable
  userId          String?       @map("user_id") @db.Uuid
  guestEmail      String?       @map("guest_email")
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod @map("payment_method")
  currency        String        @default("INR")
  subtotalPaise   Int           @map("subtotal_paise")
  discountPaise   Int           @default(0) @map("discount_paise")
  shippingPaise   Int           @default(0) @map("shipping_paise")
  taxPaise        Int           @default(0) @map("tax_paise")
  totalPaise      Int           @map("total_paise")
  couponId        String?       @map("coupon_id") @db.Uuid
  shippingAddress Json          @map("shipping_address") // snapshot at order time
  billingAddress  Json?         @map("billing_address")
  idempotencyKey  String?       @unique @map("idempotency_key")
  customerNote    String?       @map("customer_note")
  placedAt        DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon       Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  history      OrderStatusHistory[]
  payments     Payment[]
  shipments    Shipment[]
  returns      ReturnRequest[]
  redemption   CouponRedemption?
  reservations InventoryReservation[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

// Snapshot of what was sold. Editing the product later never changes this row.
model OrderItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String  @map("order_id") @db.Uuid
  variantId          String? @map("variant_id") @db.Uuid
  productName        String  @map("product_name")
  sku                String
  colourName         String? @map("colour_name")
  size               String?
  hsnCode            String? @map("hsn_code")
  quantity           Int
  unitPricePaise     Int     @map("unit_price_paise")
  discountPaise      Int     @default(0) @map("discount_paise")
  taxRateBasisPoints Int     @default(0) @map("tax_rate_basis_points")
  taxPaise           Int     @default(0) @map("tax_paise")
  totalPaise         Int     @map("total_paise")
  imageUrl           String? @map("image_url")

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

// Append-only.
model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  actorType  String       @default("system") @map("actor_type") // customer | admin | system | webhook
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // card, upi, netbanking, ... as reported by the gateway
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Raw gateway webhook log. provider_event_id UNIQUE makes processing idempotent.
model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String    @default("razorpay")
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  status          JobStatus @default(PENDING)
  error           String?
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  returnRequestId  String?      @map("return_request_id") @db.Uuid
  providerRefundId String?      @unique @map("provider_refund_id")
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(REQUESTED)
  reason           String?
  requestedById    String?      @map("requested_by_id") @db.Uuid
  approvedById     String?      @map("approved_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

// ───────────────────────── Shipping & returns ─────────────────────────

// Simple, auditable shipping rules; the checkout quote picks the first matching active rule.
model ShippingRate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  minSubtotalPaise Int      @default(0) @map("min_subtotal_paise")
  maxSubtotalPaise Int?     @map("max_subtotal_paise")
  ratePaise        Int      @map("rate_paise")
  estimatedDaysMin Int?     @map("estimated_days_min")
  estimatedDaysMax Int?     @map("estimated_days_max")
  isActive         Boolean  @default(true) @map("is_active")
  priority         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("shipping_rates")
}

model Shipment {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  carrier            String?
  awb                String? // airway bill / tracking number
  providerShipmentId String?        @map("provider_shipment_id")
  status             ShipmentStatus @default(PENDING)
  trackingUrl        String?        @map("tracking_url")
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt        DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentEvent[]

  @@unique([carrier, awb])
  @@index([orderId])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  location    String?
  description String?
  occurredAt  DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model ReturnRequest {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  status       ReturnStatus @default(REQUESTED)
  reason       String
  customerNote String?      @map("customer_note")
  decisionNote String?      @map("decision_note")
  decidedById  String?      @map("decided_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnRequestId String @map("return_request_id") @db.Uuid
  orderItemId     String @map("order_item_id") @db.Uuid
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@map("return_items")
}

// ───────────────────────── Reviews, CMS, settings ─────────────────────────

model Review {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase") // set server-side from orders
  status             ReviewStatus @default(PENDING)
  moderatedById      String?      @map("moderated_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model CmsPage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String        @unique
  title          String
  blocks         Json // structured content blocks, validated by Zod; never raw HTML from users
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("cms_pages")
}

model Banner {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placement String // e.g. home_hero, announcement_bar
  title     String?
  subtitle  String?
  linkUrl   String?       @map("link_url")
  mediaId   String?       @map("media_id") @db.Uuid
  startsAt  DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime?     @map("ends_at") @db.Timestamptz(3)
  sortOrder Int           @default(0) @map("sort_order")
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([placement, status])
  @@map("banners")
}

model SiteSetting {
  key         String   @id
  value       Json
  isPublic    Boolean  @default(false) @map("is_public")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

// ───────────────────── Audit, idempotency, notifications ─────────────────────

// Append-only (INSERT/SELECT only for the app role; trigger rejects UPDATE/DELETE).
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. product.update, refund.approve, role.assign
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String
  scope        String // route + actor, so keys cannot collide across users
  requestHash  String   @map("request_hash")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model NotificationLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  channel           String // email | sms | whatsapp
  template          String
  recipientHash     String    @map("recipient_hash") // hashed; no raw contact data in logs
  status            JobStatus @default(PENDING)
  providerMessageId String?   @map("provider_message_id")
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status])
  @@map("notification_logs")
}

// ───────────────────────────── AI assistant ─────────────────────────────

model AiConversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionRef String?  @map("session_ref") // anonymous visitor reference
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3) // retention limit; purged by job

  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           AiRole
  content        String // PII-redacted before storage
  toolName       String?  @map("tool_name")
  toolArgs       Json?    @map("tool_args")
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
